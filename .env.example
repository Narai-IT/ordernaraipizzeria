# ตั้งค่าเหล่านี้ใน Vercel → Project Settings → Environment Variables (ทั้ง Production และ Preview)

# กุญแจเซ็น token ล็อกอิน — สุ่มยาว ๆ อย่างน้อย 32 ตัว ห้ามใช้ซ้ำกับระบบอื่น
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# office-server ตัวเดียวกับ narai-branch (ต่อ SQL Server InventoryNarai ให้)
USAGE_API_BASE=https://usage.khanoykorshabu.com
# ค่าเดียวกับ API_TOKEN ใน office-server/.env (narai-branch ตั้งไว้ในชื่อ USAGE_API_TOKEN เหมือนกัน)
USAGE_API_TOKEN=

# ที่อยู่เว็บ narai-branch ที่ deploy อยู่ — ใช้ /api/insert_order และ /api/pending_orders ของที่นั่น
NARAI_BRANCH_URL=https://<โดเมนของ narai-branch>

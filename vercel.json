{
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "public/js/orderGroups.js"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
